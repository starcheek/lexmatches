# Copy to .env (gitignored). Every value is optional for local use.

# --- Auth ---
# Secret for signing JWTs. CHANGE for any non-local deployment.
JWT_SECRET=dev-insecure-jwt-secret-change-me-0123456789
JWT_TTL_HOURS=720

# --- Translation (Claude) ---
# Without a key the deterministic MockTranslator is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (empty = model default)
ANTHROPIC_EFFORT=low
# "default" = server-side refusal fallback on supported models, "off" to disable
ANTHROPIC_FALLBACKS=default
# auto (Claude if key set, else mock) | claude | mock
TRANSLATOR=auto

# --- Text-to-speech ---
# piper (local, default) | xai (Grok voices, needs XAI_API_KEY) | elevenlabs (needs ELEVENLABS_API_KEY).
# A paid provider without its key falls back to piper.
TTS_PROVIDER=piper
# xAI text-to-speech: billed per character sent ($15 per 1M characters when this was written); audio is
# cached per user, so a page is paid for once per user. Voices: GET https://api.x.ai/v1/tts/voices
XAI_API_KEY=
XAI_VOICE=eve
# Override voices per ISO language, e.g. fr=fr_FR-tom-medium,pt=pt_PT-tugão-medium
PIPER_VOICES=
# Voices downloaded in the background at startup (~63 MB each, once, into the piper-voices volume):
# all (every configured language) | none | comma list, e.g. fr,en
PIPER_PRELOAD=all
# >1 = slower speech (the reader also has a client-side speed control)
PIPER_LENGTH_SCALE=1.1
# onnxruntime threads per synthesis / concurrent syntheses (CPU-bound; keep small)
PIPER_THREADS=2
TTS_WORKERS=2
# Speech requests per user per minute
TTS_RATE_PER_MIN=120
# Cached audio (tts/<user>/<book>/...) expires after this many days (bucket lifecycle rule)
TTS_CACHE_DAYS=30
ELEVENLABS_API_KEY=

# --- Billing (off unless STRIPE_SECRET_KEY is set) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=price_1SZqBJKB40NOyEkPeUH1dv8i

# --- Usage analytics ---
# Bearer token for reading /api/admin/analytics/* (sessions, events, summary). Empty = those endpoints are off.
# Collection (POST /api/track) is always on.
ADMIN_TOKEN=

# --- Infrastructure (docker compose) ---
POSTGRES_PASSWORD=lexmatches
S3_ACCESS_KEY=lexmatches
S3_SECRET_KEY=lexmatches-secret
S3_BUCKET=books
# Largest upload accepted. On a small server (2 GB RAM) use about 25.
MAX_UPLOAD_MB=100
# New accounts start with the sample books in backend/seed; 0 turns that off
SEED_BOOKS=1
# Uploaded books are split into pages one at a time by default; the rest wait in a queue.
BOOK_WORKERS=1
