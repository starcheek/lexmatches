{
	servers {
		# Cloudflare's proxy addresses (https://www.cloudflare.com/ips/). Only a request arriving from one of
		# these may say who the visitor is; anyone else connecting directly is taken at their own address.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$SITE_DOMAIN} {
	encode zstd gzip
	# The API logs the visitor's address from this header. It is always overwritten here with the address
	# Caddy established (Cloudflare's word when proxied, the connection itself otherwise), never the visitor's claim.
	request_header CF-Connecting-IP {client_ip}
	# The health check is for the server itself (Docker and deploy/remote-deploy.sh reach it from inside):
	# not reachable from the internet.
	respond /api/health 404
	reverse_proxy web:80
}
