# Local edge function secrets. Copy to supabase/functions/.env (gitignored).
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by the local runtime.

# LLM (any OpenAI-compatible chat endpoint) — used by translate-page
AI_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_MODEL=gemini-3.1-flash-lite
AI_API_KEY=

# Stripe test key (sk_test_...) — check-subscription / create-checkout / customer-portal
STRIPE_SECRET_KEY=

# ElevenLabs — text-to-speech
ELEVENLABS_API_KEY=
